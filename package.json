{
  "name": "dsh-desktop",
  "version": "0.1.1",
  "description": "DeepSeek Harness desktop app",
  "main": "main.js",
  "author": "dsh-desktop",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ai.deepseek.dsh",
    "productName": "DeepSeek Harness",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "runtime/node",
        "to": "node"
      },
      {
        "from": "server/dsh-modules",
        "to": "app-server/node_modules"
      }
    ],
    "files": [
      "main.js",
      "build/dsh.ico"
    ],
    "win": {
      "icon": "build/dsh.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "shortcutName": "DeepSeek Harness"
    },
    "portable": {
      "artifactName": "DeepSeek-Harness-Portable-${version}.exe"
    }
  }
}
